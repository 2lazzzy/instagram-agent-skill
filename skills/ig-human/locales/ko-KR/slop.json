  "structures": [
    {"id": "middle-dot", "regex": "[가-힣A-Za-z0-9]\\s?·\\s?[가-힣A-Za-z0-9]", "name": "가운뎃점(·) 나열", "fix": "쉼표나 '와/과'로 바꾸세요. 피드 글에서 가운뎃점 나열은 기계가 쓴 글처럼 읽힙니다. 3·1절처럼 정해진 표기라면 그대로 두세요."},
    {"id": "dash", "regex": "—|―|\\s–\\s", "name": "줄표(—)", "fix": "쉼표, 콜론, 괄호로 바꾸거나 문장을 둘로 나누세요. 어느 쪽이 맞는지는 문맥이 정하므로 자동으로 바꾸지 않습니다."},
    {"id": "not-just", "regex": "(?:단순(?:히|한)|그저|단지)\\s*[^.!?\\n]{1,40}?(?:이|가)?\\s*(?:아니라|아닙니다|아니에요|아니고)", "name": "'단순히 A가 아니라 B'", "fix": "말하려는 B만 쓰고 앞 절은 지우세요."},
    {"id": "not-only", "regex": "뿐만\\s*아니라[^.!?\\n]{1,60}(?:도|까지)", "name": "'A뿐만 아니라 B도'", "fix": "두 문장으로 나누거나 약한 쪽을 지우세요."},
    {"id": "triad-geurigo", "regex": "[가-힣A-Za-z]+,\\s*[가-힣A-Za-z]+,?\\s*그리고\\s+[가-힣A-Za-z]+", "name": "'A, B, 그리고 C' 나열", "fix": "영어 쉼표 나열을 옮긴 번역투입니다. 'A, B, C' 또는 'A와 B, C'로 쓰거나, 셋 중 하나를 빼세요."},
    {"id": "staged-reveal", "regex": "(?m)^\\s*(?:결과|정답|비결|이유|핵심|방법)(?:은|는)\\s*(?:\\?|바로[.!]?)\\s*$", "name": "한 줄짜리 뜸 들이기('결과는?')", "fix": "질문으로 끊지 말고 답을 그 자리에 쓰세요."},
    {"id": "preamble", "regex": "(?:이번|오늘)\\s*(?:영상|릴스|게시물|포스팅|글)에서는?|(?:알려|소개해|보여)\\s*드리(?:겠습니다|려고\\s*합니다|도록\\s*하겠습니다)", "name": "예고('오늘 영상에서는 ~ 알려 드리겠습니다')", "fix": "지우고 결과부터 쓰세요. 처음 2초가 전부입니다."},
    {"id": "stop-scroll", "regex": "(?m)^\\s*(?:스크롤\\s*(?:멈춰|멈추|내리지)|넘기지\\s*마|잠깐만요?[!,.]?\\s)", "name": "'스크롤 멈추세요' 시작", "fix": "멈추라고 하지 말고, 멈출 만한 주장을 첫 줄에 두세요."},
    {"id": "emoji-bullets", "regex": "(?m)^\\s*[\\U0001F300-\\U0001FAFF✅➡⬅✔✨]\\s*\\S", "name": "이모지 글머리표", "fix": "하이픈이나 줄바꿈으로. 이모지 글머리표는 캡션에서 가장 템플릿 같아 보입니다."},
    {"id": "hashtag-wall", "regex": "(?:#\\w+[ \\t]*){6,}", "name": "해시태그 벽(6개 이상)", "fix": "5개 이하, 주제 태그만."},
    {"id": "follow-bait", "regex": "(?:팔로우\\s*하고\\s*(?:더|다음)|친구(?:를|들을)?\\s*태그|좋아요\\s*누르고|맞팔|선팔)", "name": "습관적인 팔로우, 태그 요청", "fix": "이 게시물이 실제로 얻을 수 있는 요청 하나만 쓰세요."},
